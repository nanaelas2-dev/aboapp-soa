<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<bean class="org.springframework.beans.factory.config.PropertyPlaceholderConfigurer">
		<property name="location" value="classpath:config.properties" />
	</bean>

	<bean id="springContext" class="ma.telecomatlas.abo.outils.SpringContext" />

	<bean id="dataSource" class="org.apache.commons.dbcp.BasicDataSource" destroy-method="close">
		<property name="driverClassName" value="${jdbc.driver}" />
		<property name="url" value="${jdbc.url}" />
		<property name="username" value="${jdbc.user}" />
		<property name="password" value="${jdbc.password}" />
		<property name="maxActive" value="${jdbc.maxActive}" />
		<property name="validationQuery" value="select 1" />
		<property name="testOnBorrow" value="true" />
	</bean>

	<bean id="jdbcTemplate" class="org.springframework.jdbc.core.JdbcTemplate">
		<property name="dataSource" ref="dataSource" />
	</bean>

	<!-- DAO -->
	<bean id="clientDao" class="ma.telecomatlas.abo.dao.ClientDao">
		<property name="jdbcTemplate" ref="jdbcTemplate" />
	</bean>
	<bean id="offreDao" class="ma.telecomatlas.abo.dao.OffreDao">
		<property name="jdbcTemplate" ref="jdbcTemplate" />
	</bean>
	<bean id="abonnementDao" class="ma.telecomatlas.abo.dao.AbonnementDao">
		<property name="jdbcTemplate" ref="jdbcTemplate" />
	</bean>
	<bean id="simDao" class="ma.telecomatlas.abo.dao.SimDAO">
		<property name="jdbcTemplate" ref="jdbcTemplate" />
	</bean>
	<bean id="consoDao" class="ma.telecomatlas.abo.dao.ConsoDao">
		<property name="jdbcTemplate" ref="jdbcTemplate" />
	</bean>
	<bean id="factureDao" class="ma.telecomatlas.abo.dao.FactureDAO">
		<property name="jdbcTemplate" ref="jdbcTemplate" />
	</bean>
	<bean id="boutiqueDao" class="ma.telecomatlas.abo.dao.BoutiqueDao">
		<property name="jdbcTemplate" ref="jdbcTemplate" />
	</bean>
	<bean id="paramDao" class="ma.telecomatlas.abo.dao.ParamDao">
		<property name="jdbcTemplate" ref="jdbcTemplate" />
	</bean>
	<bean id="portabiliteDao" class="ma.telecomatlas.abo.dao.PortabiliteDao">
		<property name="jdbcTemplate" ref="jdbcTemplate" />
	</bean>

	<!-- metier -->
	<bean id="numeroteur" class="ma.telecomatlas.abo.metier.NumeroteurHelper">
		<property name="paramDao" ref="paramDao" />
	</bean>
	<bean id="souscriptionHelper" class="ma.telecomatlas.abo.metier.SouscriptionHelper">
		<property name="abonnementDao" ref="abonnementDao" />
		<property name="offreDao" ref="offreDao" />
		<property name="simDao" ref="simDao" />
		<property name="numeroteur" ref="numeroteur" />
	</bean>

	<!-- facturation -->
	<bean id="tarifsBoutique" class="ma.telecomatlas.abo.facturation.TarifsBoutique">
		<property name="jdbcTemplate" ref="jdbcTemplate" />
	</bean>
	<bean id="facturationManager" class="ma.telecomatlas.abo.facturation.FacturationManager">
		<property name="offreDao" ref="offreDao" />
		<property name="consoDao" ref="consoDao" />
		<property name="clientDao" ref="clientDao" />
		<property name="abonnementDao" ref="abonnementDao" />
		<property name="factureDao" ref="factureDao" />
		<property name="paramDao" ref="paramDao" />
		<property name="jdbcTemplate" ref="jdbcTemplate" />
		<property name="delaiEcheance" value="${facturation.delai.echeance}" />
	</bean>
	<bean id="lotFacturation" class="ma.telecomatlas.abo.facturation.LotFacturation">
		<property name="facturationManager" ref="facturationManager" />
		<property name="abonnementDao" ref="abonnementDao" />
		<property name="factureDao" ref="factureDao" />
		<property name="consoDao" ref="consoDao" />
		<property name="clientDao" ref="clientDao" />
		<property name="paramDao" ref="paramDao" />
		<property name="numeroteur" ref="numeroteur" />
	</bean>

	<!-- services web (publies dans cxf-servlet.xml) -->
	<bean id="abonnementService" class="ma.telecomatlas.abo.soap.AbonnementService">
		<property name="clientDao" ref="clientDao" />
		<property name="abonnementDao" ref="abonnementDao" />
		<property name="offreDao" ref="offreDao" />
		<property name="simDao" ref="simDao" />
		<property name="factureDao" ref="factureDao" />
		<property name="consoDao" ref="consoDao" />
		<property name="boutiqueDao" ref="boutiqueDao" />
		<property name="portabiliteDao" ref="portabiliteDao" />
		<property name="souscriptionHelper" ref="souscriptionHelper" />
		<property name="numeroteur" ref="numeroteur" />
		<property name="facturationManager" ref="facturationManager" />
		<property name="lotFacturation" ref="lotFacturation" />
		<property name="tarifsBoutique" ref="tarifsBoutique" />
		<property name="jdbcTemplate" ref="jdbcTemplate" />
	</bean>
	<bean id="portabiliteService" class="ma.telecomatlas.abo.soap.PortabiliteService">
		<property name="portabiliteDao" ref="portabiliteDao" />
		<property name="clientDao" ref="clientDao" />
		<property name="abonnementDao" ref="abonnementDao" />
		<property name="numeroteur" ref="numeroteur" />
	</bean>

	<!-- batch activation SIM + facturation sur demande -->
	<bean id="fichierReseau" class="ma.telecomatlas.abo.batch.FichierActivationReseau">
		<property name="dossierSortie" value="${reseau.dossier.sortie}" />
		<property name="codeOperateur" value="${reseau.code.operateur}" />
	</bean>
	<bean id="compteRenduReseau" class="ma.telecomatlas.abo.batch.CompteRenduReseau">
		<property name="simDao" ref="simDao" />
		<property name="dossierEntree" value="${reseau.dossier.entree}" />
		<property name="dossierArchives" value="${reseau.dossier.archives}" />
	</bean>
	<bean id="activationSimJob" class="ma.telecomatlas.abo.batch.ActivationSimJob" init-method="demarrer" destroy-method="arreter">
		<property name="simDao" ref="simDao" />
		<property name="abonnementDao" ref="abonnementDao" />
		<property name="paramDao" ref="paramDao" />
		<property name="jdbcTemplate" ref="jdbcTemplate" />
		<property name="fichierReseau" ref="fichierReseau" />
		<property name="compteRendu" ref="compteRenduReseau" />
		<property name="periode" value="${batch.activation.periode}" />
		<property name="max" value="${batch.activation.max}" />
		<property name="actif" value="${batch.activation.actif}" />
	</bean>
</beans>
